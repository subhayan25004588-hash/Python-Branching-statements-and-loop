# ---------------- PLAYER 1 ----------------
runs1 = 148
balls1 = 50
fours1 = 6
sixes1 = 16
wickets1 = 4
runs_conceded1 = 29
overs1 = 2
catches1 = 3

strike_rate1 = (runs1 / balls1) * 100
economy1 = runs_conceded1 / overs1

# Batting Performance
if runs1 >= 50 and strike_rate1 >= 120:
    batting1 = "Excellent Batter"
elif runs1 >= 30 and strike_rate1 >= 100:
    batting1 = "Good Batter"
elif runs1 >= 20:
    batting1 = "Average Batter"
else:
    batting1 = "Poor Batter"

# Bowling Performance
if wickets1 >= 3 and economy1 <= 6:
    bowling1 = "Excellent Bowler"
elif wickets1 >= 2 and economy1 <= 8:
    bowling1 = "Good Bowler"
elif wickets1 >= 1:
    bowling1 = "Average Bowler"
else:
    bowling1 = "Poor Bowler"

# Fielding Performance
if catches1 >= 2:
    fielding1 = "Outstanding Fielder"
elif catches1 == 1:
    fielding1 = "Active Fielder"
else:
    fielding1 = "Needs Improvement"

# Overall Decision
if batting1 == "Excellent Batter" and bowling1 == "Excellent Bowler":
    overall1 = "Star All-Rounder"
elif batting1 == "Good Batter" and bowling1 == "Good Bowler":
    overall1 = "Strong All-Rounder"
elif batting1 == "Good Batter" or bowling1 == "Good Bowler":
    overall1 = "Supporting All-Rounder"
else:
    overall1 = "Needs Improvement"


